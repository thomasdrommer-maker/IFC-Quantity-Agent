  "profile_requirements": [
    {
      "id": "PR01",
      "topic_de": "Profile verwalten",
      "requirement_de": "Standardprofile schreibgeschützt mitliefern; als benutzerdefiniertes Profil kopieren. Anlegen, umbenennen, bearbeiten, duplizieren, auswählen und archivieren."
    },
    {
      "id": "PR02",
      "topic_de": "Speicherbereich",
      "requirement_de": "Persönlich oder projektbezogen; Freigabe für Kollegen separat mit Berechtigungen implementieren. Keine implizite Änderung fremder Profile."
    },
    {
      "id": "PR03",
      "topic_de": "Identität",
      "requirement_de": "Stabile profile_id, Version, Ursprung, Name, Änderungszeit und Inhalts-Fingerprint speichern. Fachliche Änderung erzeugt neue Version; alte Berichte bleiben reproduzierbar."
    },
    {
      "id": "PR04",
      "topic_de": "Anwendungsbereich",
      "requirement_de": "Objekttyp/Kategorien, Material, Querschnittsform, Mengenbasis und Zählebene explizit im scope_json. Keine Profilanwendung nur anhand eines frei geratenen Namens."
    },
    {
      "id": "PR05",
      "topic_de": "Einheiten",
      "requirement_de": "Anzeige in mm/cm/m, m², m³, kg oder kg/m. Grenzen kanonisch in m/m²/m³/kg/kg/m speichern. Einheiten nur innerhalb gleicher Dimension konvertieren."
    },
    {
      "id": "PR06",
      "topic_de": "Grenzregel",
      "requirement_de": "Untergrenze exklusiv, Obergrenze inklusive. Offene letzte Obergrenze = null/Excel-Leerwert. Untergrenzen numerisch und nicht negativ; keine Vor-Rundung."
    },
    {
      "id": "PR07",
      "topic_de": "Überlappung",
      "requirement_de": "Aktive Bänder innerhalb desselben Profils dürfen sich nicht überschneiden. Codes sind pro Profil eindeutig. Unterschiedliche Profile dürfen dieselbe Messgröße anders einteilen."
    },
    {
      "id": "PR08",
      "topic_de": "Abdeckung",
      "requirement_de": "coverage=complete verlangt lückenlose Abdeckung aller positiven Werte bis unendlich. coverage=partial erlaubt bewusste Lücken und einen begrenzten Bereich; außerhalb gilt out_of_range."
    },
    {
      "id": "PR09",
      "topic_de": "Unvollständige Daten",
      "requirement_de": "Fehlend=unknown; nicht anwendbar=not_applicable; Null/negativ/nicht endlich=invalid. Variable Dicke/Querschnitt=variable, bis eine bestätigte abschnittsweise Auswertung vorliegt."
    },
    {
      "id": "PR10",
      "topic_de": "Originalmaße",
      "requirement_de": "Rohwert, Einheit, Quelle und normalisierter Wert erhalten. Exakte Maßgruppen parallel zu Intervallen anbieten. Keine Modelländerung oder zusätzliche Verschachtelung."
    },
    {
      "id": "PR11",
      "topic_de": "Vorschau",
      "requirement_de": "Vor Speichern/Anwenden: Grenzen/Einheiten und Umfang prüfen, Treffer je Band sowie unknown/invalid/variable/not_applicable/out_of_range/conflict zeigen. Drilldown auf Objekte."
    },
    {
      "id": "PR12",
      "topic_de": "Auswertungswechsel",
      "requirement_de": "Profilwechsel kategorisiert neu; keine Rohmengenänderung. Kombinierte Filter sind Schnittmengen. Alternative Profile niemals zu zusätzlicher Materialmenge addieren."
    },
    {
      "id": "PR13",
      "topic_de": "Import/Export",
      "requirement_de": "Profile und Bänder über Excel/JSON austauschen. Fehlende Pflichtfelder, unbekannte Metriken, doppelte IDs/Versionen mit anderem Inhalt, ungültige Scopes oder Intervalle atomar ablehnen."
    },
    {
      "id": "PR14",
      "topic_de": "Aktivierung",
      "requirement_de": "Entwurfsprofile nicht automatisch aktivieren. Erst nach Validierung und Nutzerwahl anwenden; ungültiger Import erhält letzte gültige Konfiguration."
    },
    {
      "id": "PR15",
      "topic_de": "Stützen",
      "requirement_de": "Rechteck b/h in lokalen Querschnittsachsen und Rund-Ø trennen. A nur aus bestätigtem Querschnitt; nicht beliebig Volumen/Höhe bei veränderlichem Querschnitt. Rechteck- und Rundprofile getrennt filtern."
    },
    {
      "id": "PR16",
      "topic_de": "Wände",
      "requirement_de": "Dicke normal zur Wandfläche, vertikale Höhe und Achslänge mit bestätigter Konvention. Wandansichtsfläche, Öffnungsabzüge und Schalungskontaktfläche bleiben verschiedene Messgrößen."
    },
    {
      "id": "PR17",
      "topic_de": "Bleche",
      "requirement_de": "Nennblechdicke aus bestätigter Profil-/Materialquelle oder validierter lokaler Geometrie. Nicht kleinste globale Bounding-Box-Abmessung. Modellierte Dicke allein beweist keinen Stahlwerkstoff."
    },
    {
      "id": "PR18",
      "topic_de": "Blechflächen",
      "requirement_de": "Gross/Net und Fläche der Mittelfläche versus Oberfläche unterscheiden. Ausgeklinkte/gelochte Bleche nicht über Außenrechteck als Nettofläche rechnen. Abwicklung gekanteter Bleche nur mit bestätigter Quelle."
    },
    {
      "id": "PR19",
      "topic_de": "Ergebnisvertrag",
      "requirement_de": "Je Objekt: profile_id, profile_version, profile_fingerprint, metric, category_code, classification_status, canonical_value, quantity_basis und evaluation_level ausgeben. Bericht enthält Modellstand und Profilversionen."
    },
    {
      "id": "PR20",
      "topic_de": "UI-Workflow",
      "requirement_de": "Kategorieprofile öffnen, Messgröße und Scope wählen, Grenzen/Bezeichnungen pflegen, Vorschau, Speichern als neue Version, Anwenden. Noch nicht gespeichert/ungültig darf nicht als aktives Profil erscheinen."
    }
  ],
